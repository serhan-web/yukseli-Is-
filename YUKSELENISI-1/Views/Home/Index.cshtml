					</div>
					<div class="contact-info-item">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s7-6.3 7-11.5A7 7 0 105 9.5C5 14.7 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.3" /></svg>
						<div>
							<div class="small text-uppercase font-mono" style="color:#8DA0AF;">Adres</div>
							<div>İZMİR/KARŞIYAKA/TÜRKİYE</div>
						</div>
					</div>
					<div class="contact-info-item">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
						<div>
							<div class="small text-uppercase font-mono" style="color:#8DA0AF;">Çalışma Saatleri</div>
							<div>Pzt–Cmt, 08:00–18:00</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-7 reveal">
				<div class="border rounded-3 p-4 p-md-5 h-100">
					<h3 class="mb-4" style="font-size:1.6rem;">Ücretsiz keşif ve teklif formu</h3>

					@if (TempData["Basarili"] != null)
					{
						<div class="alert alert-success">@TempData["Basarili"]</div>
					}

					<form asp-controller="Home" asp-action="Iletisim" method="post">
						<div class="row g-3">
							<div class="col-md-6">
								<label class="form-label small font-mono text-uppercase">Ad Soyad</label>
								<input type="text" name="AdSoyad" class="form-control form-control-custom" placeholder="Adınız Soyadınız" required>
							</div>
							<div class="col-md-6">
								<label class="form-label small font-mono text-uppercase">Telefon</label>
								<input type="tel" name="Telefon" class="form-control form-control-custom" placeholder="05xx xxx xx xx" required>
							</div>
							<div class="col-12">
								<label class="form-label small font-mono text-uppercase">Hizmet Türü</label>
								<select name="HizmetTuru" class="form-select form-control-custom">
									<option>Baca / Havalandırma</option>
									<option>İzolasyon</option>
									<option>Klima Santrali</option>
									<option>Diğer</option>
								</select>
							</div>
							<div class="col-12">
								<label class="form-label small font-mono text-uppercase">Mesajınız</label>
								<textarea name="Mesaj" class="form-control form-control-custom" rows="4" placeholder="Projeniz hakkında kısaca bilgi verin"></textarea>
							</div>
							<div class="col-12">
								<button type="submit" class="btn btn-primary-custom w-100 w-md-auto">Talebi Gönder</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>
