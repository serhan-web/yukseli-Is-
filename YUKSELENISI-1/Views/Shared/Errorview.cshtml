@model YUKSELENISI_1.Models.ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata.</h1>
<h2 class="text-danger">İsteğinizi işlerken bir sorun oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Geliştirme Modu</h3>
<p>
    Geliştirme ortamındaysanız daha ayrıntılı hata bilgisi için
    <code>launchSettings.json</code> içindeki ortam ayarını <code>Development</code> yapın.
</p>
