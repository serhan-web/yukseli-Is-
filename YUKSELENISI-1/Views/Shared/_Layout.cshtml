<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - İzoder</title>
    <meta name="description" content="Fabrika, otel, restoran ve ofisler için izolasyon, baca ve havalandırma sistemleri projelendirme, imalat ve montaj hizmetleri.">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

    <style>
        :root{
          --navy:#0F1E2E;
          --charcoal:#1C2733;
          --steel:#5C7085;
          --mist:#F2F5F7;
          --paper:#FFFFFF;
          --teal:#0EA5A0;   /* hava akışı - soğuk */
          --amber:#E07A2C;  /* izolasyon - sıcak */
          --line:#DDE3E8;
        }

        html{scroll-behavior:smooth;}
        body{
          font-family:'Inter', sans-serif;
          color:var(--charcoal);
          background:var(--paper);
        }
        h1,h2,h3,h4,.font-display{
          font-family:'Space Grotesk', sans-serif;
          letter-spacing:-0.01em;
        }
        .font-mono{
          font-family:'JetBrains Mono', monospace;
          letter-spacing:0.02em;
        }
        .text-teal{color:var(--teal)!important;}
        .text-amber{color:var(--amber)!important;}
        .bg-navy{background:var(--navy)!important;}
        .bg-mist{background:var(--mist)!important;}
        .eyebrow{
          font-family:'JetBrains Mono', monospace;
          font-size:.75rem;
          letter-spacing:.14em;
          text-transform:uppercase;
          color:var(--teal);
          display:flex;
          align-items:center;
          gap:.6rem;
        }
        .eyebrow::before{
          content:"";
          width:22px;height:2px;
          background:var(--amber);
          display:inline-block;
        }

        /* NAVBAR */
        .navbar{
          background:rgba(15,30,46,.92);
          backdrop-filter:blur(8px);
          padding-top:.9rem;padding-bottom:.9rem;
        }
        .navbar .navbar-brand{
          font-family:'Space Grotesk',sans-serif;
          font-weight:700;
          color:#fff;
          font-size:1.25rem;
        }
        .navbar .navbar-brand span{color:var(--teal);}
        .navbar-nav .nav-link{
          color:#C7D2DB;
          font-weight:500;
          font-size:.92rem;
          margin:0 .4rem;
        }
        .navbar-nav .nav-link:hover{color:#fff;}
        .btn-call{
          background:var(--teal);
          color:#fff;
          border-radius:2px;
          font-family:'JetBrains Mono',monospace;
          font-size:.85rem;
          padding:.5rem 1rem;
        }
        .btn-call:hover{background:#0c8b87;color:#fff;}

        /* HERO */
        .hero{
          background:var(--navy);
          color:#fff;
          position:relative;
          overflow:hidden;
          padding-top:8.5rem;
          padding-bottom:5rem;
        }
        .hero::after{
          content:"";
          position:absolute;
          inset:0;
          background:
            linear-gradient(180deg, transparent 60%, var(--paper) 100%);
          pointer-events:none;
        }
        .hero h1{
          font-size:clamp(2.2rem, 4vw, 3.4rem);
          font-weight:700;
          line-height:1.1;
        }
        .hero .lead{
          color:#AEC0CC;
          max-width:520px;
        }
        .btn-primary-custom{
          background:var(--amber);
          border:none;
          color:#fff;
          padding:.85rem 1.6rem;
          border-radius:2px;
          font-weight:600;
          font-size:.95rem;
        }
        .btn-primary-custom:hover{background:#c76a24;color:#fff;}
        .btn-outline-custom{
          border:1px solid #3A4C5C;
          color:#fff;
          padding:.85rem 1.6rem;
          border-radius:2px;
          font-weight:600;
          font-size:.95rem;
        }
        .btn-outline-custom:hover{border-color:var(--teal);color:var(--teal);}

        /* Duct schematic svg */
        .duct-wrap{position:relative;}
        .duct-dot{
          animation: flow 3.2s linear infinite;
        }
        .duct-dot.d2{animation-delay:1.05s;}
        .duct-dot.d3{animation-delay:2.1s;}
        @@keyframes flow{
          0%{offset-distance:0%; opacity:0;}
          8%{opacity:1;}
          92%{opacity:1;}
          100%{offset-distance:100%; opacity:0;}
        }
        .duct-dot{ offset-path:path("M20,140 L120,140 L120,60 L260,60 L260,180 L400,180 L400,100 L520,100"); offset-rotate:0deg;}

        /* stat strip */
        .stat-strip{
          border-top:1px solid var(--line);
          border-bottom:1px solid var(--line);
        }
        .stat-num{
          font-family:'JetBrains Mono',monospace;
          font-size:2.1rem;
          font-weight:600;
          color:var(--navy);
        }
        .stat-label{
          font-size:.82rem;
          color:var(--steel);
          text-transform:uppercase;
          letter-spacing:.06em;
        }

        /* section spacing */
        .section{padding:5.5rem 0;}
        .section-tight{padding:4rem 0;}

        /* pillars */
        .pillar{
          border-left:2px solid var(--line);
          padding-left:1.1rem;
        }
        .pillar .num{
          font-family:'JetBrains Mono',monospace;
          color:var(--amber);
          font-size:.85rem;
        }

        /* service cards */
        .service-card{
          background:#fff;
          border:1px solid var(--line);
          border-radius:4px;
          padding:1.6rem 1.4rem;
          height:100%;
          transition:border-color .2s, transform .2s;
        }
        .service-card:hover{
          border-color:var(--teal);
          transform:translateY(-3px);
        }
        .service-icon{
          width:42px;height:42px;
          margin-bottom:.9rem;
          color:var(--teal);
        }
        .service-card h3{
          font-size:1.02rem;
          font-weight:600;
          margin-bottom:.4rem;
        }
        .service-card p{
          font-size:.87rem;
          color:var(--steel);
          margin-bottom:0;
        }

        /* team */
        .team-card{text-align:center;}
        .avatar{
          width:104px;height:104px;
          border-radius:50%;
          margin:0 auto 1rem;
          display:flex;align-items:center;justify-content:center;
          background:var(--navy);
          color:#fff;
          font-family:'Space Grotesk',sans-serif;
          font-weight:600;
          font-size:1.6rem;
          position:relative;
        }
        .avatar::after{
          content:"";
          position:absolute;
          inset:-5px;
          border:1px dashed var(--amber);
          border-radius:50%;
        }
        .team-role{
          font-family:'JetBrains Mono',monospace;
          font-size:.78rem;
          color:var(--teal);
          text-transform:uppercase;
          letter-spacing:.05em;
        }

        /* products */
        .product-tile{
          background:var(--mist);
          border-radius:4px;
          padding:2rem 1.2rem;
          text-align:center;
          height:100%;
          border:1px solid transparent;
          transition:.2s;
        }
        .product-tile:hover{border-color:var(--teal); background:#fff;}
        .product-tile svg{width:38px;height:38px;color:var(--amber); margin-bottom:.8rem;}
        .product-tile h4{font-size:.92rem;font-weight:600;margin-bottom:0;}

        /* gallery */
        .gallery-tile{
          aspect-ratio:4/3;
          border-radius:4px;
          background:linear-gradient(135deg, var(--navy), var(--steel));
          position:relative;
          overflow:hidden;
          display:flex;align-items:flex-end;
        }
        .gallery-tile span{
          color:#fff;
          font-family:'JetBrains Mono',monospace;
          font-size:.75rem;
          padding:.6rem;
          opacity:.85;
        }
        .gallery-tile:nth-child(2n){background:linear-gradient(135deg,#16333a,var(--teal));}
        .gallery-tile:nth-child(3n){background:linear-gradient(135deg,#3a2415,var(--amber));}

        /* contact */
        .contact-card{
          background:var(--navy);
          color:#fff;
          border-radius:6px;
          padding:2.5rem;
        }
        .contact-info-item{
          display:flex;gap:.9rem;
          padding:1rem 0;
          border-bottom:1px solid rgba(255,255,255,.1);
        }
        .contact-info-item:last-child{border-bottom:none;}
        .contact-info-item svg{width:20px;height:20px;color:var(--teal); flex-shrink:0; margin-top:.15rem;}
        .form-control-custom{
          background:var(--mist);
          border:1px solid var(--line);
          border-radius:3px;
          padding:.75rem .9rem;
        }
        .form-control-custom:focus{
          border-color:var(--teal);
          box-shadow:0 0 0 .2rem rgba(14,165,160,.15);
        }

        /* footer */
        footer{background:#0B1620;color:#8DA0AF;}
        footer a{color:#C7D2DB; text-decoration:none;}
        footer a:hover{color:var(--teal);}
        footer h5{color:#fff; font-family:'Space Grotesk',sans-serif; font-size:1rem;}
        .social-dot{
          width:36px;height:36px;
          border:1px solid #2A3A47;
          border-radius:50%;
          display:flex;align-items:center;justify-content:center;
          color:#C7D2DB;
        }
        .social-dot:hover{border-color:var(--teal); color:var(--teal);}

        /* reveal on scroll */
        .reveal{opacity:0; transform:translateY(16px); transition:opacity .6s ease, transform .6s ease;}
        .reveal.is-visible{opacity:1; transform:translateY(0);}

        @@media (prefers-reduced-motion: reduce){
          .reveal{opacity:1; transform:none; transition:none;}
          .duct-dot{animation:none;}
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

